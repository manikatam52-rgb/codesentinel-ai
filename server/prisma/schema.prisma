generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AnalysisStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ReviewStatus {
  PENDING
  COMPLETED
  FAILED
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  githubToken  String? // encrypted at rest by the app layer
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships Membership[]
  assignedIssues Issue[] @relation("Assignee")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  projects  Project[]
  memberships Membership[]

  @@unique([name])
}

model Membership {
  id        String @id @default(cuid())
  role      Role   @default(DEVELOPER)
  userId    String
  orgId     String
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  repoOwner   String
  repoName    String
  defaultBranch String @default("main")
  orgId       String
  createdAt   DateTime @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  analyses   Analysis[]
  reviews    PullRequestReview[]
  issues     Issue[]

  @@unique([orgId, repoOwner, repoName])
}

model Analysis {
  id           String         @id @default(cuid())
  projectId    String
  commitSha    String
  branch       String
  status       AnalysisStatus @default(PENDING)
  qualityScore Float?
  startedAt    DateTime       @default(now())
  completedAt  DateTime?

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  findings    Finding[]
  testRuns    TestRun[]

  @@index([projectId, startedAt])
}

model Finding {
  id          String   @id @default(cuid())
  analysisId  String
  filePath    String
  line        Int
  ruleId      String
  title       String
  description String
  severity    Severity
  category    String // bug | security | quality
  suggestion  String?

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

model PullRequestReview {
  id         String       @id @default(cuid())
  projectId  String
  prNumber   Int
  headSha    String
  title      String
  author     String
  status     ReviewStatus @default(PENDING)
  summary    String?
  qualityScore Float?
  createdAt  DateTime     @default(now())
  completedAt DateTime?

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments ReviewComment[]

  @@unique([projectId, prNumber, headSha])
}

model ReviewComment {
  id         String   @id @default(cuid())
  reviewId   String
  filePath   String
  line       Int
  severity   Severity
  body       String

  review PullRequestReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Issue {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String
  status      IssueStatus @default(OPEN)
  severity    Severity    @default(MEDIUM)
  filePath    String?
  line        Int?
  assigneeId  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?     @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
}

model TestRun {
  id          String   @id @default(cuid())
  analysisId  String
  passed      Int
  failed      Int
  skipped     Int
  durationMs  Int
  log         String?
  createdAt   DateTime @default(now())

  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id         String   @id @default(cuid())
  deliveryId String   @unique
  event      String
  payload    Json
  processed  Boolean  @default(false)
  createdAt  DateTime @default(now())
}
